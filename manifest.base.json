{
  "name": "Vibesearch",
  "description": ".",
  "manifest_version": 3,
  "options_ui": {
    "page": "src/pages/options/index.html"
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["storage", "activeTab", "tabs", "tabGroups", "scripting", "offscreen", "alarms"],
  "devtools_page": "src/pages/devtools/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png",
        "src/pages/search/index.html",
        "src/pages/offscreen/offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://huggingface.co https://cas-bridge.xethub.hf.co https://cdn.jsdelivr.net https://meta.vibesearch.app"
  }
}
